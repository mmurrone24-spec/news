# -----------------------------
# Hilfsfunktionen
# -----------------------------
def clean_text(text: str) -> str:
    if not text:
        return ""
    text = re.sub(r"<[^>]+>", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def get_sentiment_score(text: str) -> float:
    if not text:
        return 0.0
    text_lower = text.lower()
    bull = sum(1 for kw in BULLISH_KEYWORDS if kw in text_lower)
    bear = sum(1 for kw in BEARISH_KEYWORDS if kw in text_lower)
    keyword_score = (bull - bear) / max(bull + bear, 1)
    try:
        tb_score = TextBlob(text).sentiment.polarity
    except Exception:
        tb_score = 0.0
    final = 0.55 * keyword_score + 0.45 * tb_score
    return max(min(final, 1.0), -1.0)


def bias_label(score: float) -> tuple[str, str]:
    if score > 0.22:
        return "Bullisch ↗", "#22c55e"
    elif score < -0.22:
        return "Bearisch ↘", "#ef4444"
    return "Neutral →", "#94a3b8"


def probability_from_score(score: float) -> dict:
    bull = int(50 + score * 38)
    bull = max(12, min(88, bull))
    return {"bullisch": bull, "bearisch": 100 - bull}


@st.cache_data(ttl=300, show_spinner=False)
def fetch_prices():
    """Holt aktuelle Preise und Tagesveränderung für alle Commodities."""
    results = {}
    all_tickers = []
    ticker_to_name = {}
    for category, items in COMMODITIES.items():
        for name, ticker in items.items():
            all_tickers.append(ticker)
            ticker_to_name[ticker] = (category, name)
            if category not in results:
                results[category] = {}
            results[category][name] = {"ticker": ticker, "price": None, "change_pct": None}

    # Einzelne Ticker nacheinander (stabiler auf Streamlit Cloud)
    for ticker in all_tickers:
        category, name = ticker_to_name[ticker]
        try:
            t = yf.Ticker(ticker)
            hist = t.history(period="5d")
            if hist is not None and not hist.empty and "Close" in hist.columns:
                close = hist["Close"].dropna()
                if len(close) >= 1:
                    price = float(close.iloc[-1])
                    change_pct = None
                    if len(close) >= 2:
                        prev = float(close.iloc[-2])
                        if prev != 0:
                            change_pct = ((price - prev) / prev) * 100
                    results[category][name] = {
                        "ticker": ticker,
                        "price": price,
                        "change_pct": change_pct,
                    }
        except Exception:
            # Ticker überspringen, App soll nicht abstürzen
            continue

    return results


def fetch_single_feed(url: str, max_entries: int = 8):
    try:
        headers = {"User-Agent": "Mozilla/5.0 (compatible; CommodityDashboard/2.0)"}
        resp = requests.get(url, headers=headers, timeout=10)
        feed = feedparser.parse(resp.content)
        entries = []
        for entry in feed.entries[:max_entries]:
            title = clean_text(entry.get("title", ""))
            summary = clean_text(entry.get("summary", entry.get("description", "")))
            if len(title) < 12:
                continue
            entries.append({
                "title": title,
                "summary": summary[:350] + ("..." if len(summary) > 350 else ""),
                "link": entry.get("link", ""),
                "published": entry.get("published", entry.get("updated", "")),
                "score": get_sentiment_score(title + " " + summary),
            })
        return entries
    except Exception:
        return []


@st.cache_data(ttl=600, show_spinner=False)
def load_news():
    results = {}
    for category, urls in NEWS_FEEDS.items():
        all_entries = []
        with ThreadPoolExecutor(max_workers=4) as executor:
            futures = [executor.submit(fetch_single_feed, url) for url in urls]
            for future in as_completed(futures):
                all_entries.extend(future.result())

        # Deduplizieren
        seen = set()
        unique = []
        for e in all_entries:
            key = e["title"][:70].lower()
            if key not in seen:
                seen.add(key)
                unique.append(e)
        unique.sort(key=lambda x: abs(x["score"]), reverse=True)
        results[category] = unique[:18]
    return results


def call_llm(api_key: str, base_url: str, model: str, headlines: list[str], commodity: str) -> str:
    """Ruft ein OpenAI-kompatibles LLM auf (OpenAI, xAI/Grok, Together, etc.)."""
    if not api_key or not headlines:
        return ""

    prompt = f"""Du bist ein erfahrener Rohstoff-Analyst.
Fasse die folgenden aktuellen Nachrichten zu {commodity} in 4-6 klaren, neutralen Sätzen zusammen.
Hebe die wichtigsten Treiber (Angebot, Nachfrage, Geopolitik, Wetter, Lagerbestände) hervor.
Gib am Ende eine kurze Einschätzung der aktuellen Stimmung (bullisch / neutral / bearisch) und warum.
Antworte auf Deutsch.

Nachrichten:
{chr(10).join(f"- {h}" for h in headlines[:12])}
"""

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }
    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": "Du bist ein präziser, nüchterner Rohstoff-Analyst. Keine Anlageberatung."},
            {"role": "user", "content": prompt},
        ],
        "temperature": 0.3,
        "max_tokens": 500,
    }

    try:
        resp = requests.post(
            f"{base_url.rstrip('/')}/chat/completions",
            headers=headers,
            json=payload,
            timeout=30,
        )
        if resp.status_code == 200:
            return resp.json()["choices"][0]["message"]["content"].strip()
        else:
            return f"LLM-Fehler ({resp.status_code}): {resp.text[:200]}"
    except Exception as e:
        return f"LLM-Verbindungsfehler: {e}"


